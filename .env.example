# Copy this file to .env and fill in your own key. Never commit .env.
# Get a key at https://console.anthropic.com/ (API usage is billed to your account).
ANTHROPIC_API_KEY=

# Optional: model for live mode. Default: claude-opus-5.
# Cheaper alternative: claude-sonnet-5
CONSENTGUARD_MODEL=claude-opus-5

# Optional: server-side refusal fallback for Opus 5 / Fable models ("default" or "off").
CONSENTGUARD_FALLBACKS=default
