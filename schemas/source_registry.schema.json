        "retrieval_date": {
          "title": "Retrieval Date",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "applicability_notes": {
          "title": "Applicability Notes",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "jurisdiction",
        "source_type",
        "title",
        "issuing_authority",
        "official_url",
        "provision",
        "publication_date",
        "effective_date",
        "verification_status",
        "retrieval_date",
        "summary",
        "applicability_notes"
