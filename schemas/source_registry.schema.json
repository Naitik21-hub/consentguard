  "properties": {
    "registry_version": {
      "title": "Registry Version",
      "type": "string"
    },
    "last_verification_date": {
      "title": "Last Verification Date",
      "type": "string"
    },
    "verification_method": {
      "title": "Verification Method",
      "type": "string"
    },
    "important_note": {
      "title": "Important Note",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/LegalSource"
      },
      "title": "Sources",
      "type": "array"
