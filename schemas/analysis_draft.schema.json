{
  "$defs": {
    "ConsentDimension": {
      "additionalProperties": false,
      "properties": {
        "dimension_id": {
          "enum": [
            "purpose_clarity",
            "optional_separation",
            "choice_granularity",
            "affirmative_action",
            "withdrawal",
            "recipient_retention_transparency",
            "bundling_or_misleading"
          ],
          "title": "Dimension Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "adequate",
            "concern",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "dimension_id",
        "status",
        "explanation"
      ],
      "title": "ConsentDimension",
      "type": "object"
    },
    "DataInventoryItem": {
      "additionalProperties": false,
      "properties": {
        "data_category": {
          "title": "Data Category",
          "type": "string"
        },
        "collection_basis": {
          "default": "stated",
          "enum": [
            "stated",
            "inferred",
            "permission_only",
            "unknown"
          ],
          "title": "Collection Basis",
          "type": "string"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "recipients": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipients"
        },
        "retention": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "data_category"
      ],
      "title": "DataInventoryItem",
      "type": "object"
    },
    "DraftFinding": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low",
            "informational"
          ],
          "title": "Severity",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "quotes": {
          "items": {
            "$ref": "#/$defs/Quote"
          },
          "title": "Quotes",
          "type": "array"
        },
        "missing_context": {
          "items": {
            "type": "string"
          },
          "title": "Missing Context",
          "type": "array"
        },
        "recommended_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Action"
        }
      },
      "required": [
        "rule_id",
        "severity",
        "confidence",
        "title",
        "explanation"
      ],
      "title": "DraftFinding",
      "type": "object"
    },
    "NextStep": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "conditional": {
          "default": false,
          "title": "Conditional",
          "type": "boolean"
        }
      },
      "required": [
        "action"
      ],
      "title": "NextStep",
      "type": "object"
    },
    "PermissionMapItem": {
      "additionalProperties": false,
      "properties": {
        "permission": {
          "title": "Permission",
          "type": "string"
        },
        "feature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "required_status": {
          "default": "unknown",
          "enum": [
            "required",
            "optional",
            "unknown"
          ],
          "title": "Required Status",
          "type": "string"
        },
        "assessment": {
          "enum": [
            "proportionate",
            "needs_explanation",
            "disproportionate",
            "insufficient_information"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "permission",
        "assessment",
        "rationale"
      ],
      "title": "PermissionMapItem",
      "type": "object"
    },
    "PlainSummary": {
      "additionalProperties": false,
      "properties": {
        "data_collected": {
          "items": {
            "$ref": "#/$defs/SummaryPoint"
          },
          "title": "Data Collected",
          "type": "array"
        },
        "purposes": {
          "items": {
            "$ref": "#/$defs/SummaryPoint"
          },
          "title": "Purposes",
          "type": "array"
        },
        "recipients": {
          "items": {
            "$ref": "#/$defs/SummaryPoint"
          },
          "title": "Recipients",
          "type": "array"
        },
        "retention": {
          "items": {
            "$ref": "#/$defs/SummaryPoint"
          },
          "title": "Retention",
          "type": "array"
        },
        "choices_and_withdrawal": {
          "items": {
            "$ref": "#/$defs/SummaryPoint"
          },
          "title": "Choices And Withdrawal",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "title": "PlainSummary",
      "type": "object"
    },
    "Quote": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "quote"
      ],
      "title": "Quote",
      "type": "object"
    },
    "SummaryPoint": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "basis": {
          "default": "stated",
          "enum": [
            "stated",
            "inferred",
            "unknown"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "SummaryPoint",
      "type": "object"
    },
    "TargetedQuestion": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "why_it_matters": {
          "title": "Why It Matters",
          "type": "string"
        }
      },
      "required": [
        "question",
        "why_it_matters"
      ],
      "title": "TargetedQuestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Exactly what the model (or a demo fixture) returns.",
  "properties": {
    "document_title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Title"
    },
    "document_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Version"
    },
    "plain_english_summary": {
      "$ref": "#/$defs/PlainSummary"
    },
    "data_inventory": {
      "items": {
        "$ref": "#/$defs/DataInventoryItem"
      },
      "title": "Data Inventory",
      "type": "array"
    },
    "permission_purpose_map": {
      "items": {
        "$ref": "#/$defs/PermissionMapItem"
      },
      "title": "Permission Purpose Map",
      "type": "array"
    },
    "consent_dimensions": {
      "items": {
        "$ref": "#/$defs/ConsentDimension"
      },
      "title": "Consent Dimensions",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/DraftFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "targeted_questions": {
      "items": {
        "$ref": "#/$defs/TargetedQuestion"
      },
      "title": "Targeted Questions",
      "type": "array"
    },
    "next_steps": {
      "items": {
        "$ref": "#/$defs/NextStep"
      },
      "title": "Next Steps",
      "type": "array"
    }
  },
  "required": [
    "plain_english_summary"
  ],
  "title": "AnalysisDraft",
  "type": "object"
}
